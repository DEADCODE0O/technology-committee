# ═══════════════════════════════════════════════════════════════
#  متغيرات البيئة — منصة اللجنة التكنولوجية
#  محليًا: انسخ هذا الملف إلى .env (وضع التطوير يعمل بدون Supabase)
#  إنتاجًا: ضع هذه القيم في Vercel → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── 1) قاعدة البيانات (Supabase PostgreSQL) ──────────────────────
# من Supabase → Project Settings → Database:
# • DATABASE_URL = Connection Pooling → Session mode (منفذ 6543) — لتشغيل التطبيق
# • DIRECT_URL   = Connection string → URI (منفذ 5432) — للترحيلات فقط
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── 2) Supabase Auth (البريد + OTP + Google) ──────────────────────
# من Supabase → Project Settings → API:
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-public-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key-سري-لا-يصل-للمتصفح]"

# ── 3) Supabase Storage (رفع صور الأنشطة) ────────────────────────
# أنشئ bucket عام باسم workshops ثم اترك القيمة الافتراضية:
SUPABASE_BUCKET="workshops"

# ── 4) أمان الجلسات (وضع التطوير المحلي فقط) ─────────────────────
# مطلوب للتشغيل المحلي بدون Supabase — وفي الإنتاج يُنصح بضبطه كاحتياط
# توليد سر قوي: openssl rand -base64 48
AUTH_SECRET="[random-secret-at-least-32-chars]"

# ── 5) رابط الموقع ────────────────────────────────────────────────
# بعد النشر على Vercel ضع رابطك النهائي (بدون شرطة ختامية)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── 6) خدمة SMS (اختياري — موصولة هيكليًا فقط) ────────────────────
SMS_MODE="none" # none | sandbox | live
SMS_API_KEY=""
SMS_SENDER=""
