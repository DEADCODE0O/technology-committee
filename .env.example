# ═══════════════════════════════════════════════════════════════
#  متغيرات البيئة لمنصة اللجنة التكنولوجية (Technology Committee)
#  انسخ هذا الملف إلى .env وضع القيم الخاصة بمشروعك على Supabase و Vercel
# ═══════════════════════════════════════════════════════════════

# 1. قاعدة البيانات (Supabase PostgreSQL)
# استخدم رابط الـ Session Pooler (الموصى به لـ Vercel Serverless):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# رابط الاتصال المباشر (Direct Connection) المستخدم للهجرات وإدارة المخطط:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. أمان الجلسات والمصادقة
# مفتاح سري عشوائي بطول 32 حرفاً على الأقل لتوقيع الجلسات و JWT
AUTH_SECRET="your-super-secret-auth-key-at-least-32-characters-long"

# رابط موقعك (محلياً أو على Vercel)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 3. تكامل Supabase Auth & Storage (اختياري / للرفع السحابي والمصادقة)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_BUCKET="tech-committee-uploads"

# 4. خدمة الرسائل القصيرة SMS (اختياري)
SMS_MODE="none" # none | sandbox | live
SMS_API_KEY=""
SMS_SENDER=""
