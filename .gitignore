# env files — أسرار البيئة لا تُرفع للمستودع أبدًا:
# الإعدادات المحلية في .env (نسخها من .env.example)
# وأسرار الإنتاج تُضبط كمتغيرات بيئة في لوحة Vercel.
.env
.env.*
!.env.example

# قواعد البيانات المحلية (بيانات مستخدمين — لا تُرفع أبدًا)
db/*.db
db/*.db-journal
*.sqlite
*.sqlite3

# ملفات مرفوعة وقت التشغيل
public/uploads/
uploads/

# vercel
.vercel


